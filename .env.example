# .env.example - MongoDB Version
# Example environment variables for the Playlist Recommender project.
# Copy this file to .env and fill in your actual values.
# DO NOT commit the .env file to version control. Add .env to .gitignore.

# --- Spotify API Credentials ---
SPOTIPY_CLIENT_ID="YOUR_SPOTIFY_CLIENT_ID"
SPOTIPY_CLIENT_SECRET="YOUR_SPOTIFY_CLIENT_SECRET"
SPOTIPY_REDIRECT_URI="http://localhost:8888/callback" # Or your configured URI

# --- MongoDB Configuration ---
# Get your connection string from MongoDB Atlas (use the "mongodb+srv://" format)
# Ensure your IP address is whitelisted in Atlas Network Access settings.
MONGODB_URI="mongodb+srv://<username>:<password>@<your-atlas-cluster-uri>/?retryWrites=true&w=majority"
MONGODB_DB_NAME="playlist_recommender_db" # Or your preferred database name
# Optional: Customize collection names
# MONGO_PLAYLIST_COLLECTION="playlists"
# MONGO_TRACK_COLLECTION="tracks"
# MONGO_AUDIO_FEATURES_COLLECTION="audio_features"

# --- AWS Configuration (Region might still be needed for Fargate/other services) ---
AWS_REGION="us-east-1" # Or your preferred AWS region
# S3_BUCKET_NAME="your-playlist-recommender-bucket-name" # REMOVED

# --- Redis Configuration (for Caching - Phase 6) ---
# Keep if Redis caching is still planned
REDIS_URL="redis://localhost:6379/0"

# --- Application Settings ---
LOG_LEVEL="INFO" # DEBUG, INFO, WARNING, ERROR

# --- Model/Feature Configuration ---
RECOMMENDER_ALPHA_WEIGHT="0.6"
RECOMMENDER_N_RESULTS="30"
ANN_N_CANDIDATES="500"

# --- Prefect Configuration (Optional) ---
# PREFECT_API_URL="YOUR_PREFECT_CLOUD_API_URL_OR_LOCAL_SERVER"
# PREFECT_API_KEY="YOUR_PREFECT_API_KEY"

# --- Evidently AI Monitoring (Phase 7) ---
# EVIDENTLY_SERVICE_URL=""
